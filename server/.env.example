# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: leave DB_ENGINE=sqlite for dev. For an on-site server / cloud use postgres.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
DB_NAME=camhealth
DB_USER=camhealth
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Comma-separated origins allowed to call the API (desktop dev, website, mobile).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Mobile Money (Phase 1 billing). Fill when integrating.
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
